# Copy this file to .env and fill your values
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=your-secret-key-here
HOST=0.0.0.0
PORT=5000
DOMAIN=http://127.0.0.1:5000
DATABASE_URL=sqlite:///panel.db
DB_FILE=panel.db
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=524288000
MAX_FILE_SIZE_MB=500
ALLOWED_EXTENSIONS=zip,rar,txt,pdf,png,jpg,jpeg,gif,mp4,mp3
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_EMAIL=admin@hostpanel.local
DEFAULT_COINS=100
COIN_PRICE_INR=10
SIGNUP_BONUS=100
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@hostpanel.local
BCRYPT_ROUNDS=12
JWT_SECRET=your-jwt-secret-here
CSRF_ENABLED=True
APP_NAME=HostPanel
APP_VERSION=1.0.0
APP_DESCRIPTION=Single File Hosting Control Panel
DEBUG=True
