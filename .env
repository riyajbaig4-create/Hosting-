# ============================================================
#  HOSTPANEL - Environment Configuration
# ============================================================

# ---------- FLASK ----------
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=change-this-to-random-secret-key-please
SESSION_COOKIE_NAME=hostpanel_session
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax

# ---------- SERVER ----------
HOST=0.0.0.0
PORT=5000
DOMAIN=http://127.0.0.1:5000

# ---------- DATABASE ----------
DATABASE_URL=sqlite:///panel.db
DB_FILE=panel.db
DB_TIMEOUT=30

# ---------- UPLOAD ----------
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=524288000
ALLOWED_EXTENSIONS=zip,rar,txt,pdf,png,jpg,jpeg,gif,mp4,mp3,py,js,html,css,json,db
MAX_FILE_SIZE_MB=500

# ---------- ADMIN ----------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_EMAIL=admin@hostpanel.local

# ---------- COINS / BILLING ----------
DEFAULT_COINS=100
COIN_PRICE_INR=10
SIGNUP_BONUS=100

# ---------- EMAIL (optional) ----------
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@hostpanel.local

# ---------- SECURITY ----------
BCRYPT_ROUNDS=12
JWT_SECRET=change-this-jwt-secret-too
CSRF_ENABLED=True

# ---------- APP META ----------
APP_NAME=HostPanel
APP_VERSION=1.0.0
APP_DESCRIPTION=Single File Hosting Control Panel
DEBUG=True
